# Ambiente
ENVIRONMENT=development
PORT=8000

# Banco de Dados Dedicado (PromptOps PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prompt_ops_db

# Redis / Filas ARQ
REDIS_URL=redis://localhost:6379/0

# Supabase Produção (Acesso para Prompts e client_configurations)
SUPABASE_URL=https://sdkymfktruvsdlqmkqeh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Provedores de LLM
OPENAI_API_KEY=sua_openai_api_key
ANTHROPIC_API_KEY=sua_anthropic_api_key

# Configurações do Juiz de Evals
EVAL_JUDGE_MODEL=gpt-4o
EVAL_APPROVAL_THRESHOLD=0.90
